# Copy to .env and fill in.

NODE_ENV=development
PORT=4001

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Neon PostgreSQL
# ---------------------------------------------------------------------------
# Pooled host (contains "-pooler") for the app:
DATABASE_URL=
# Direct host for drizzle-kit migrations; falls back to DATABASE_URL if empty:
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# JWT secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
