# Copy to .env and fill in.

NODE_ENV=development
PORT=4001

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Neon PostgreSQL
# ---------------------------------------------------------------------------
# Pooled host (contains "-pooler") for the app:
DATABASE_URL=
# Direct host for drizzle-kit migrations; falls back to DATABASE_URL if empty:
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# JWT secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# Encryption for secrets stored in the database (the assistant key today).
# Falls back to JWT_REFRESH_SECRET if unset, but set it: then rotating the JWT
# secret does not orphan everything already stored.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# The assistant (optional). Normally set from Settings by a Super Admin, which
# needs no redeploy — this is the fallback for an operator who would rather
# keep credentials out of the database entirely.
#   https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
