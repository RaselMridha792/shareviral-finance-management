{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Without this, drizzle.config.ts at the package root widens the inferred
    // root and the build lands in dist/src/ instead of dist/.
    "rootDir": "./src",
    // nest-cli wipes dist on every build, but the .tsbuildinfo outlives it and
    // then reports files as already emitted — leaving a half-empty dist.
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "drizzle.config.ts",
    "**/*spec.ts"
  ]
}
