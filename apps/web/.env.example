# Copy to .env.local and fill in.

# ---------------------------------------------------------------------------
# Where the NestJS API lives.
# ---------------------------------------------------------------------------
# Used by the server (Server Components, and the proxy that renews the access
# token). Absolute, because a Server Component has no origin to be relative to.
API_URL=http://localhost:4001/api

# Used by the browser. In production set this to the RELATIVE path "/api" so
# requests stay on the web app's own origin and the httpOnly, sameSite=lax
# cookies are actually sent. Pointing it at the API hostname makes sign-in look
# like it works until the first reload.
NEXT_PUBLIC_API_URL=http://localhost:4001/api
