# Copy to deploy/.env and fill in. This file is git-ignored.
#
# Generate every secret below on the server, and never paste one into a chat,
# a commit, or a ticket.

# --------------------------------------------------------------------------
# Hostnames
# --------------------------------------------------------------------------
# Where people open the app. This is the origin the API allows through CORS.
WEB_ORIGIN=https://app.hellonizam.com

# Where the browser sends its API calls. Baked into the browser bundle at build
# time, so changing it means rebuilding the web image, not just restarting it.
API_ORIGIN=https://api.hellonizam.com

# The parent domain, with a leading dot, so the auth cookies are sent to both
# hostnames above.
#
# This is the setting that makes two subdomains work at all: app.* renders every
# page on the server and needs the session cookie, and a host-only cookie
# written by api.* never reaches it. Sign-in would succeed and every page would
# still say signed out.
#
# The cost: every subdomain of this domain receives the session cookie. Do not
# host anything you do not control under it.
COOKIE_DOMAIN=.hellonizam.com

# --------------------------------------------------------------------------
# Database — pick one of the two
# --------------------------------------------------------------------------
#
# (a) Somewhere managed, such as Neon. Paste its connection string here and
#     leave the POSTGRES_* lines empty. Nothing else changes, and the data is
#     already there.
#
#         docker compose up -d
#
DATABASE_URL=
# Neon gives a second, direct (unpooled) host. Optional; falls back to the one
# above when empty.
DATABASE_URL_UNPOOLED=

# (b) Postgres on this server. Fill the three below, point DATABASE_URL at the
#     `db` service, and start it with the profile:
#
#         DATABASE_URL=postgres://sfm:THE_PASSWORD_BELOW@db:5432/sfm
#         docker compose --profile local-db up -d
#
#     You own the backups then. deploy/backup.sh is written for it, and the
#     restore has been rehearsed — see STATUS.md.
#
POSTGRES_USER=sfm
POSTGRES_DB=sfm
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Generate each separately. Do not reuse the development ones.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts secrets kept in the database — the assistant API key today. Rotating
# this makes everything already stored unreadable, and the app will say so
# rather than fail: a Super Admin re-enters the key from Settings.
SECRET_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# Images — optional, and the way back from a bad deploy
# --------------------------------------------------------------------------
# CI tags every image twice: `latest`, and the exact commit it was built from.
# Leave these alone and the server runs `latest`.
#
# To roll back, set IMAGE_TAG to the commit SHA that was working and run
# `docker compose up -d`. No rebuild, no waiting on CI — the image is already
# in the registry.
#
# IMAGE_TAG=9f2c1ab...
# IMAGE_API=ghcr.io/raselmridha792/sfm-api
# IMAGE_WEB=ghcr.io/raselmridha792/sfm-web
