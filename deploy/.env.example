# Copy to deploy/.env and fill in. This file is git-ignored.

# How the browser reaches the app. With no domain this is the VPS IP over
# HTTPS, e.g. https://203.0.113.10
PUBLIC_ORIGIN=https://YOUR-SERVER-IP

POSTGRES_USER=sfm
POSTGRES_DB=sfm
# openssl rand -base64 32
POSTGRES_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Generate each separately. Do not reuse the development ones.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts secrets kept in the database — the assistant API key today. Rotating
# this makes everything already stored unreadable, and the app will say so
# rather than fail: a Super Admin re-enters the key from Settings.
SECRET_ENCRYPTION_KEY=
