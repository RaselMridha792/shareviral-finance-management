# Every minute.
#
# The cost of asking is one `git fetch` against GitHub, which is cheaper than
# the alternative: a deploy that waits for somebody to notice it did not
# happen. Nothing is pulled and nothing restarts unless a new commit's images
# are actually in the registry.
[Unit]
Description=SFM — check for a new release every minute

[Timer]
OnBootSec=2min

# After the last run *finished*, not after it started.
#
# This said `OnUnitActiveSec`, which schedules relative to the service's last
# activation — and so schedules nothing at all while that activation is still
# considered active. One run that does not exit cleanly is enough: the timer
# reports `Trigger: n/a` and never fires again, silently, while `systemctl
# status` still says `active (running)` and looks healthy.
#
# Whether that is what stalled the server on 2026-08-20 is not settled — the
# journal would have said, and it was not read before the deploy was run by
# hand. The change is worth making either way: this is the failure mode the
# unit had, and none of it was visible from outside the box.
#
# `OnUnitInactiveSec` cannot stall that way. It measures from the moment the
# service goes inactive, so the next check is always scheduled by the end of
# the previous one, however that end came about.
OnUnitInactiveSec=1min

# So a box that was off does not fire a burst of catch-up runs on boot.
AccuracySec=15s
Persistent=false

[Install]
WantedBy=timers.target
