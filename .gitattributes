# Normalise to LF in the repository regardless of who checks it out. Without
# this, a Windows checkout rewrites every file's endings and the next diff is
# the whole project.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
